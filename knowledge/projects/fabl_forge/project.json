  "do": [
    "Reuse shared_dirt / joint_dirt across set dressing",
    "Prefer cool greystone over warm desert tan for keep exteriors",
    "Keep foam and emissive as accents, not base layers",
    "Validate every new mat against active scene ensemble",
    "Author height grayscale read before polishing normals",
    "Expose color/wear/density/roughness for scene variants",
    "Test new mats beside ensemble under target light/camera",
    "Leather: share dirt with courtyard gear; matte used hide default"
  ],
  "dont": [
    "Tropical teal water in keep interiors",
    "High-sat grass against desat medieval stone without story reason",
    "Random emissive sparkles on mundane props",
    "Photoreal pore noise on stylized hero tiles",
    "Uncontrolled high-frequency noise for realism",
    "Inconsistent detail density next to quieter neighbors",
    "Scale mismatches (giant grain beside fine cobble)",
    "Shiny plastic PBR leather; high-sat orange new-belt next to desat stone"
  ],
  "default_scene": "keep_courtyard_overcast",
  "references": [
    "donor stylized_cobblestone_pavement (structure)",
    "donor stylized_lava_cracked (heat language)",
    "donor stylized_ocean_water (wave language)"
  ],
  "notes": "Production art bible. Donors optional for topology only; look from this bible.",
  "style_dna": {
    "shape_language": "readable_chunky_fantasy - clear silhouettes, soft bevels, no photo breakup",
    "detail_density": "fewer_and_larger",
    "wear_philosophy": "contact_logical - dirt in joints, edge wear on tops, shared dirt hue",
    "albedo_lighting_policy": "soft_baked_cues_ok - gentle AO/edge in albedo allowed; no harsh fake sun streaks",
    "frequency_policy": {
      "low": "required_macro_structure",
      "mid": "sculpt_wear_color_zones",
      "high": "restrained_or_none"
    },
    "scale_notes": "cobble ~ hand-sized; plank width stable across set; wave length broad ocean not puddle ripples",
    "hierarchy_default": "world_quiet_hero_loud"
  },
  "core_hue_count_target": 4,
  "test_together_required": true,
  "material_families": {
    "leather": {
      "role_in_world": "hero gear / straps / books / satchels (not world fill)",
      "shape_language": "soft pebbled grain, broad creases (fewer and larger)",
      "detail_density": "mid grain OK, no pore soup",
      "wear": "edge scuffs, fold darkening, contact dirt in seams",
      "scale": "pebble ~2-5mm at hero cam; crease wavelength much larger",
      "roughness": [
        0.55,
        0.8
      ],
      "metallic": 0,
      "emissive": "never",
      "hierarchy_default": "hero or secondary"
    }
  }
